# Override ADCore PV TriggerMode to link w/ our camera PVs
record( mbbo, "$(P)$(R)TriggerMode" )
{
	field( DOL,  "2" )
	field( PINI, "YES" )
	field( ZRVL, "0" )	field( ZRST, "FreeRun" )
	field( ONVL, "1" )	field( ONST, "External" )
	field( TWVL, "2" )	field( TWST, "Pulse" )
	field( FLNK, "$(P)$(R)AxisCalcAcqTrigMode" )
}
# Use calcout records to update both GC_AcqTrigMode and GC_TrigExpType
# For TriggerMode FreeRun
#	GC_AcqTrigMode=FreeRunning
#	GC_TrigExpType=TrigTimed
# For TriggerMode External
#	GC_AcqTrigMode=Standard
#	GC_TrigExpType=TrigTimed
# For TriggerMode Pulse
#	GC_AcqTrigMode=Standard
#	GC_TrigExpType=TrigWidth
record( calcout, "$(P)$(R)AxisCalcAcqTrigMode" )
{
	field( INPA, "$(P)$(R)TriggerMode" )
	field( CALC, "A>0" )
	field( OUT,  "$(P)$(R)GC_AcqTrigMode PP MS" )
	field( FLNK, "$(P)$(R)AxisCalcTrigExpType" )
}
record( calcout, "$(P)$(R)AxisCalcTrigExpType" )
{
	field( INPA, "$(P)$(R)TriggerMode" )
	field( CALC, "A>0" )
        field( OCAL, "A==2" )
	field( OUT,  "$(P)$(R)GC_TrigExpType PP MS" )
        field( OOPT, "When Non-zero" )
        field( DOPT, "Use OCAL" )
}

record( mbbi, "$(P)$(R)TriggerMode_RBV" )
{
	field( ZRVL, "0" )	field( ZRST, "FreeRun" )
	field( ONVL, "1" )	field( ONST, "External" )
	field( TWVL, "2" )	field( TWST, "Pulse" )
}

# Use calcout records to implement a software interlock for the sensor temperature
# Operating temperature range: -55C to 60C
record( calcout, "$(P)$(R)SensorTempMonCal" )
{
        field( INPA, "$(P)$(R)GC_SensorTemperature_RBV CP" )
        field( INPB, "55" )
        field( CALC, "A>B" )
        field( OUT,  "$(P)$(R)GC_AcquisitionStop.PROC MS" )
        field( OOPT, "When Non-zero" )
}

# Add EGU and SCAN field for the GC_SensorTemperature_RBV
record ( ai, "$(P)$(R)GC_SensorTemperature_RBV" )
{
       field( EGU, "C" )
       field( SCAN, "1 second" )
}

# Add EGU and SCAN field for the GC_DeviceTemperature_RBV
record ( ai, "$(P)$(R)GC_DeviceTemperature_RBV" )
{
       field( EGU, "C" )
       field( SCAN, "1 second" )
}

# When the Acquire PV is activated, set ReadStatus.SCAN to Passive.
# When the Acquire PV is deactivated, set ReadStatus.SCAN to 1 second
# to prevent scanning from overloading the CPU.
record(calcout, "$(P)$(R)AcquireToScanCal")
{
    field(INPA,  "$(P)$(R)Acquire CP")
# If Acquire is Done, ReadScanStatus.SCAN is 6 (1 second). If Acquire is Acquire, ReadScanStatus.Scan is 0 (Passive).
    field(CALC, "A=0?6:0")
    field(OUT, "$(P)$(R)ReadStatus.SCAN PP")
    filed(SCAN, "Passive")
}

